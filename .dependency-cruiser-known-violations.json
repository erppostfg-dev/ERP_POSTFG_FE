[
  {
    "type": "dependency",
    "from": "src/constants/pages.ts",
    "to": "src/lib/data.ts",
    "rule": {
      "severity": "error",
      "name": "constants-are-leaves"
    }
  },
  {
    "type": "cycle",
    "from": "src/api/intransit.ts",
    "to": "src/dev/intransitPreview.ts",
