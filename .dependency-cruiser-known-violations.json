      {
        "name": "src/api/intransit.ts",
        "dependencyTypes": [
          "local",
          "type-only",
          "import"
        ]
      }
    ]
  },
  {
    "type": "dependency",
    "from": "src/api/intransit.ts",
    "to": "src/dev/intransitPreview.ts",
    "rule": {
      "severity": "error",
      "name": "no-dev-only-in-app"
    }
  },
  {
    "type": "dependency",
    "from": "src/auth/AuthContext.tsx",
    "to": "src/dev/intransitPreview.ts",
    "rule": {
      "severity": "error",
      "name": "no-dev-only-in-app"
    }
  }
]
